{
  "name": "gm2godot-deep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "deep-convert": "bin/deep-convert.mjs"
  },
  "scripts": {
    "deep-convert": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "test": "node --test tests/",
    "test:integration": "DEEP_INTEGRATION=1 node --test tests/integration/",
    "demo": "node src/cli/main.ts run --workspace examples/workspace --through report"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  }
}
